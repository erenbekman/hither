{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hither",
  "version": "../package.json",
  "identifier": "dev.hither.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Hither",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Eren Bekman"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNjNEQjU5QzFCODdCRUEKUldUcWU3akJXZHRqckphZUllK2ZuSG1uQjIrZ3pBdmxoSmVqbko4T0NrQWRQVFl1LzV1akdxWlUK",
      "endpoints": [
        "https://github.com/erenbekman/hither/releases/latest/download/latest.json"
      ]
    }
  }
}
